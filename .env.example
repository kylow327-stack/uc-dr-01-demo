# Optional narrative model for the risk_summarize node (CP-LLM) only.
# Leave every value unset to stay on fixtures. That is the default and the
# path this demo is meant to run. The model is never allowed to set the risk
# tier (CP-SCORE). Do not send real customer documents or live case folders.

# Public OpenAI-compatible endpoint. Used only when OPENAI_API_KEY is set
# and the Azure trio below is not fully set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure OpenAI shaped vars. Used only when all three are set.
# Point these at a private endpoint you control. This public demo is not a
# place for bank PII, even if the endpoint is private.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
